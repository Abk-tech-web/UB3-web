rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- meta/stats -----------------------------------------------------
    // A single counter document tracking how many leader accounts exist
    // (meta/stats -> { leaderCount: number }). Anyone can read it (so the
    // portal can show a friendly "spots full" message before someone even
    // tries to sign up). It can only ever be created at 1, or incremented
    // by exactly 1 at a time, and can never exceed MAX_LEADER_ACCOUNTS
    // below — this is what makes the 9-account cap race-safe: two people
    // signing up at the same instant can't both succeed past 9.
    match /meta/stats {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.leaderCount == 1;
      allow update: if request.auth != null
                    && request.resource.data.leaderCount == resource.data.leaderCount + 1
                    && request.resource.data.leaderCount <= 9;
      allow delete: if false;
    }

    // ---- leaders/{uid} -----------------------------------------------
    // Anyone can read leader profiles (shown on the public site).
    // Only the signed-in leader who owns the document can edit it.
    // Creation has NO identity/email check — signup is open to anyone —
    // but is capped at 9 total accounts by checking the meta/stats
    // counter above. js/auth.js creates this document and bumps the
    // counter together in one transaction, so this rule and the
    // meta/stats rule together are what actually enforce the cap
    // server-side (the check in auth.js is just a friendlier first pass).
    match /leaders/{leaderId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == leaderId
                    && (!exists(/databases/$(database)/documents/meta/stats)
                        || get(/databases/$(database)/documents/meta/stats).data.leaderCount < 9);
      allow update: if request.auth != null && request.auth.uid == leaderId;
      allow delete: if false;
    }

    // ---- messages/{messageId} -----------------------------------------
    // Visitors (unauthenticated) can create a message for a leader or the
    // general inbox. A leader can read/mark-as-read messages addressed to
    // them personally, AND any message in the shared "general" inbox
    // (visible to all 9 leaders). Nobody can delete via the client.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['toLeaderId', 'fromName', 'fromEmail', 'body'])
                    && request.resource.data.fromName is string
                    && request.resource.data.fromEmail is string
                    && request.resource.data.body is string;
      allow read, update: if request.auth != null
                    && (request.auth.uid == resource.data.toLeaderId || resource.data.toLeaderId == "general");
      allow delete: if false;
    }

    // ---- notifications/{notificationId} --------------------------------
    // A leader gets one of these whenever a visitor likes/comments on
    // their post, likes their comment, or replies to their comment
    // (js/main.js writes these as a side effect of those actions — never
    // when a leader does it to their own post/comment). Only the
    // recipient can ever read their own notifications or mark one read.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.leaderId;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.leaderId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['leaderId', 'type', 'actorName', 'body', 'read', 'createdAt'])
                    && request.resource.data.leaderId is string
                    && request.resource.data.leaderId != request.auth.uid
                    && exists(/databases/$(database)/documents/leaders/$(request.resource.data.leaderId))
                    && request.resource.data.type is string
                    && request.resource.data.actorName is string
                    && request.resource.data.actorName.size() <= 80
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 300
                    && request.resource.data.read == false;
      allow delete: if false;
    }

    // ---- announcements/{announcementId} --------------------------------
    // Public homepage feed of updates. Anyone (including signed-out
    // visitors) can read announcements. Only a signed-in leader — i.e.
    // one of the 9 accounts covered by the MAX_LEADER_ACCOUNTS cap above,
    // since that's the only way to obtain a Firebase Auth session in this
    // project — can create one, and only as themselves (authorId must
    // match their own uid; they cannot post as someone else). A leader
    // can only edit or delete their own announcements.
    //
    // Signed-out visitors are additionally allowed to nudge ONLY the
    // denormalized likeCount/commentCount fields by exactly ±1 per write
    // (isValidCounterUpdate below) — this is what powers the public
    // like/comment counts without giving visitors any other write access
    // to the post itself.
    function isValidCounterUpdate() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      // Floor the "old" value at 0 before comparing: if an old bug ever
      // left a count negative, this treats it as if it were 0 so the next
      // legitimate like/comment self-heals it instead of being stuck
      // forever trying to add/subtract 1 from a broken base.
      let oldLikeRaw = ('likeCount' in resource.data) ? resource.data.likeCount : 0;
      let oldLike = oldLikeRaw < 0 ? 0 : oldLikeRaw;
      let oldCommentRaw = ('commentCount' in resource.data) ? resource.data.commentCount : 0;
      let oldComment = oldCommentRaw < 0 ? 0 : oldCommentRaw;
      return (diffKeys.hasOnly(['likeCount'])
              && request.resource.data.likeCount is int
              && request.resource.data.likeCount >= 0
              && request.resource.data.likeCount >= oldLike - 1
              && request.resource.data.likeCount <= oldLike + 1)
          || (diffKeys.hasOnly(['commentCount'])
              && request.resource.data.commentCount is int
              && request.resource.data.commentCount >= 0
              && request.resource.data.commentCount >= oldComment - 1
              && request.resource.data.commentCount <= oldComment + 1);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.keys().hasAll(['authorId', 'authorName', 'title', 'body', 'createdAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 5000
                    // Optional photo, stored as a base64 data URL (no Firebase
                    // Storage / Blaze plan needed) — capped well under
                    // Firestore's 1MiB per-document limit.
                    && (!('imageUrl' in request.resource.data)
                        || (request.resource.data.imageUrl is string
                            && request.resource.data.imageUrl.size() <= 900000))
                    // Optional topic tag, shown as a filterable chip.
                    && (!('category' in request.resource.data)
                        || (request.resource.data.category is string
                            && request.resource.data.category.size() <= 40))
                    // Optional poll: 2-4 fixed options, votes start at all
                    // zero — isValidPollVoteUpdate (below) is the only way
                    // those numbers can ever move afterward.
                    && (!('poll' in request.resource.data)
                        || (request.resource.data.poll.question is string
                            && request.resource.data.poll.question.size() > 0
                            && request.resource.data.poll.question.size() <= 200
                            && request.resource.data.poll.options is list
                            && request.resource.data.poll.options.size() >= 2
                            && request.resource.data.poll.options.size() <= 4
                            && request.resource.data.poll.votes is list
                            && request.resource.data.poll.votes.size() == request.resource.data.poll.options.size()
                            && pollVotesSum(request.resource.data.poll.votes) == 0));
      allow update: if (request.auth != null
                    && request.auth.uid == resource.data.authorId
                    && request.resource.data.authorId == resource.data.authorId)
                    || isValidCounterUpdate()
                    || isValidPollVoteUpdate();
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      // A poll never has more than 4 options, so this ternary chain covers
      // every valid size without needing a loop (rules has none).
      function pollVotesSum(list) {
        return list.size() == 2 ? list[0] + list[1]
             : list.size() == 3 ? list[0] + list[1] + list[2]
             : list[0] + list[1] + list[2] + list[3];
      }

      // Any signed-in (non-anonymous) visitor may cast exactly one vote per
      // write: the poll's question/options are immutable once posted, and
      // the votes list may only change by exactly +1 in total across all
      // options (which option got the vote is trusted to the client, same
      // trust model as everything else here — there's no real stake in a
      // community sentiment poll).
      function isValidPollVoteUpdate() {
        let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
        return ('poll' in resource.data)
            && request.auth != null
            && request.auth.token.firebase.sign_in_provider != 'anonymous'
            && diffKeys.hasOnly(['poll'])
            && resource.data.poll.question == request.resource.data.poll.question
            && resource.data.poll.options == request.resource.data.poll.options
            && request.resource.data.poll.votes is list
            && request.resource.data.poll.votes.size() == resource.data.poll.votes.size()
            && pollVotesSum(request.resource.data.poll.votes) == pollVotesSum(resource.data.poll.votes) + 1;
      }

      // ---- announcements/{announcementId}/pollVotes/{uid} ---------------
      // One doc per voter (doc id = their own uid), so — like comments —
      // this is a real, unspoofable one-vote cap, not just a device guess.
      // A vote is final: no update/delete, so nobody can vote, see the
      // results, then switch to whichever option is winning.
      match /pollVotes/{uid} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.resource.data.keys().hasAll(['optionIndex', 'createdAt'])
                      && request.resource.data.optionIndex is int
                      && request.resource.data.optionIndex >= 0;
        allow update, delete: if false;
      }

      // ---- announcements/{announcementId}/likes/{deviceId} -------------
      // One doc per visitor device (id generated client-side and stored in
      // localStorage). Anyone can create OR overwrite their own like doc —
      // write (not just create) matters here because if a like doc already
      // exists for that device (e.g. left over from earlier testing),
      // Firestore treats re-liking as an "update" rather than a "create";
      // only allowing create would silently reject that and make the like
      // never actually land, even though the UI showed it succeeding.
      match /likes/{likeId} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if true;
      }

      // ---- announcements/{announcementId}/comments/{commentId} ---------
      // Public comments. Every commenter — including visitors who never
      // create an account — is signed in anonymously by the client
      // (js/main.js calls signInAnonymously), so `uid` is a real,
      // unspoofable Firebase Auth id, not just a self-reported field. That
      // lets us safely allow a commenter to edit or delete ONLY their own
      // comment later, without requiring a real account.
      //
      // Commenting requires a REAL signed-in identity — Google Sign-In for
      // visitors, or a leader's own dashboard login — never the plain
      // anonymous session (js/main.js still uses that for likes, but no
      // longer offers a free-typed name for comments, since that was
      // trivially spoofable). `name` must match what that identity
      // actually asserts: the leader's own profile name if the uid is a
      // registered leader, otherwise the exact name on their Google
      // account — so nobody can type a different person's name.
      // Requires the "Anonymous" AND "Google" sign-in providers enabled in
      // Firebase Console > Authentication > Sign-in method, and this site's
      // domain added under Authentication > Settings > Authorized domains.
      //
      // A comment may optionally carry `parentId`, pointing at another
      // comment in the same subcollection — that's what makes it a reply
      // (Facebook-style: the client only offers "Reply" on top-level
      // comments, so this never nests more than one level deep, though
      // the rule itself doesn't need to enforce that).
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasAll(['uid', 'name', 'body', 'createdAt'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 80
                      && (request.resource.data.name == request.auth.token.name
                          || exists(/databases/$(database)/documents/leaders/$(request.auth.uid)))
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 1000
                      && (!('photoURL' in request.resource.data)
                          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
                      && (!('parentId' in request.resource.data)
                          || (request.resource.data.parentId is string
                              && request.resource.data.parentId.size() > 0
                              && exists(/databases/$(database)/documents/announcements/$(announcementId)/comments/$(request.resource.data.parentId))))
                      && (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0);
        allow update: if (request.auth != null
                      && request.auth.uid == resource.data.uid
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.name == resource.data.name
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 1000)
                      || isValidCommentLikeUpdate();
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

        // Any signed-in visitor may nudge ONLY the comment's own likeCount
        // by ±1 (same self-healing, floor-at-0 pattern as post likes).
        // Reacting (unlike commenting) still doesn't require Google
        // Sign-In — there's no name attached to a like, so there's
        // nothing to spoof.
        function isValidCommentLikeUpdate() {
          let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
          let oldRaw = ('likeCount' in resource.data) ? resource.data.likeCount : 0;
          let old = oldRaw < 0 ? 0 : oldRaw;
          return request.auth != null
              && diffKeys.hasOnly(['likeCount'])
              && request.resource.data.likeCount is int
              && request.resource.data.likeCount >= 0
              && request.resource.data.likeCount >= old - 1
              && request.resource.data.likeCount <= old + 1;
        }

        // ---- .../comments/{commentId}/likes/{uid} ----------------------
        // One doc per visitor (doc id = their anonymous-or-real auth uid),
        // so unlike post likes this is a real, unspoofable one-reaction cap.
        match /likes/{uid} {
          allow read: if true;
          allow write: if request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.keys().hasOnly(['createdAt']);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
